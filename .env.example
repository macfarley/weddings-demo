# =============================================================================
# Environment Variables — John & Crystal Wedding Site
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase — project reference (used by CLI commands like `supabase db push`)
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_REF=

# Supabase CLI access token (DO NOT commit real value — used by CI/CD only)
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Browser-safe Supabase settings (NEXT_PUBLIC_ is exposed to the client)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Wedding slug used to filter photos/guestbook entries per-couple in the DB.
# Set to a URL-safe slug, e.g. "may-collins-2026"
NEXT_PUBLIC_WEDDING_SLUG=

# ---------------------------------------------------------------------------
# Cloudflare Worker — base URL for the moderation + gallery API
# Example: https://worker.yourname.workers.dev
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WORKER_BASE_URL=

# ---------------------------------------------------------------------------
# Server-side only — never expose in browser, never commit
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Geo + access control (Next.js middleware / proxy.ts)
# ---------------------------------------------------------------------------
# Set to "true" to restrict access to Midwest US states only (OH/IN/MI/KY/PA etc.)
# Leave unset or set to "false" for US-only (no state check).
RESTRICT_TO_MIDWEST=false

# ---------------------------------------------------------------------------
# Worker secrets — set via `wrangler secret put` (NOT via this file)
# Documented here for reference only.
# ---------------------------------------------------------------------------
# ADMIN_PASSWORD=        (wrangler secret)
# CLIENT_PASSWORD=       (wrangler secret)
# ADMIN_ORIGIN=          (wrangler secret — your Vercel app URL)
# SITE_ORIGIN=           (wrangler secret — comma-separated allowed origins)
# HF_TOKEN=              (wrangler secret — HuggingFace API token for NSFW classifier)
# SLACK_WEBHOOK_URL=     (wrangler secret — Slack incoming webhook for weekly egress report)
# RESTRICT_TO_MIDWEST=   (wrangler secret — set "true" to restrict Worker to Midwest states)

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets — set via `supabase secrets set`
# Documented here for reference only.
# ---------------------------------------------------------------------------
# SLACK_WEBHOOK_URL=     (supabase secret — Slack webhook for egress-report function)
# RESEND_API_KEY=        (supabase secret — Resend API key for email delivery)
# RESEND_TO=             (supabase secret — recipient email for Resend delivery)
# RESEND_FROM=           (supabase secret — sender address for Resend delivery)
